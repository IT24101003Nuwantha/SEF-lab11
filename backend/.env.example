# ==============================================================
# CampusEats Backend Environment Configuration (.env)
# ==============================================================

# Database Connection (Supabase PostgreSQL or Local Docker)
# Option 1: Supabase URI format (Direct or Pooler session mode, port 5432):
# ConnectionStrings__Default=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Option 2: Supabase Key-Value format (ADO.NET):
# ConnectionStrings__Default=Host=aws-0-[REGION].pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.[YOUR-PROJECT-REF];Password=[YOUR-PASSWORD];SSL Mode=Require;Trust Server Certificate=true;
#
# Option 3: Local Docker PostgreSQL:
ConnectionStrings__Default=Host=localhost;Port=5433;Database=campuseats;Username=postgres;Password=YOUR_LOCAL_PASSWORD

# Alternatively, you can also use DATABASE_URL or SUPABASE_DB_URL:
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# JWT Authentication
Jwt__Key=dev-only-secret-change-me-min-32-characters!!
Jwt__Issuer=CampusEats
Jwt__Audience=CampusEatsUsers

# CORS Allowed Origin
Frontend__Url=http://localhost:5173

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
