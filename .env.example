# ==========================================
# Frontend Environment Variables (.env)
# ==========================================
VITE_API_URL=http://localhost:5178

# ==========================================
# Backend Environment Variables (.env)
# ==========================================
# Supabase PostgreSQL (Supports URI or ADO.NET Key-Value formats):
# ConnectionStrings__Default=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Or using DATABASE_URL:
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Local Docker PostgreSQL:
ConnectionStrings__Default=Host=localhost;Port=5433;Database=campuseats;Username=postgres;Password=YOUR_DATABASE_PASSWORD

Jwt__Key=dev-only-secret-change-me-min-32-characters!!
Jwt__Issuer=CampusEats
Jwt__Audience=CampusEatsUsers
Frontend__Url=http://localhost:5173
ASPNETCORE_ENVIRONMENT=Development
PORT=8080
